{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "rootDir": "src",
        "outDir": "dist",
        "sourceMap": false,
        "skipLibCheck": true,
        "noImplicitOverride": true
    },
    "include": ["src"]
}
